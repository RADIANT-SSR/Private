*.swo

# macOS
.DS_Store

# LibreOffice lock files
.~lock.*#

# mkdocs build output
site/

# Scenario results workbooks — regenerate-on-demand (OPERATING_MODEL Rule 26);
# committed scenario figures are inventoried in each outputs/MANIFEST.md
scenarios/*/*/outputs/*.xlsx

# MODTRAN tape5 decks — deterministic from modtran_run_matrix.csv via
# scripts/render_modtran_decks.py; regenerate-on-demand (Rule 26), not
# committed. Real tape7 outputs (once obtained externally) are placed
# by hand under tests/integration/fixtures/modtran/ or data/atmospheres/
# per docs/plans/MODTRAN_Run_Matrix_Plan.md §7, not here.
modtran/decks/

# Synthetic (NOT real) tape7 outputs — deterministic from
# modtran_run_matrix.csv via scripts/generate_synthetic_tape7.py;
# regenerate-on-demand (Rule 26), not committed. See
# modtran/synthetic/README.md for what these are (and are not) for.
modtran/synthetic/*.tp7
modtran/synthetic/_cache/

# Data files (large assets shipped separately)
data/solar/*.bin
data/atmospheres/*.bin

# Golden result backups
tests/golden/*.bak

# Test artifacts (regeneratable plots)
src/radiant/atmosphere/tests/artifacts/
scenarios/04_lisa_analyst/4.3_camouflage_effectiveness/outputs/derived/
